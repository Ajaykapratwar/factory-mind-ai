      "post": {
        "tags": [
          "Control Tower"
        ],
        "summary": "Resolve Decision",
        "description": "Resolve a decision with role-based access control.\nPlanner attempting to resolve a QA-gated or BLOCK decision returns HTTP 403 Forbidden (\u00a710.4).",
        "operationId": "resolve_decision_v1_decisions__decision_id__resolve_post",
        "parameters": [
          {
            "name": "decision_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Decision Id"
