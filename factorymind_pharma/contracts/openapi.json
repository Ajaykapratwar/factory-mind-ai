  "components": {
    "schemas": {
      "AuditVerificationResult": {
        "properties": {
          "is_valid": {
            "type": "boolean",
            "title": "Is Valid"
          },
          "total_records": {
            "type": "integer",
            "title": "Total Records"
          },
          "broken_index": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Broken Index"
          },
          "latest_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Hash"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "is_valid",
          "total_records",
          "message"
        ],
        "title": "AuditVerificationResult"
      },
      "ColdChainEvent": {
        "properties": {
          "type": {
            "type": "string",
            "const": "cold_chain_event",
            "title": "Type",
            "default": "cold_chain_event"
          },
          "origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "destination": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination"
          },
          "start_day": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Day",
            "description": "Start day relative to simulation start"
          },
          "duration_days": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Duration Days",
            "description": "Duration of cold-chain event in days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_day",
          "duration_days"
        ],
        "title": "ColdChainEvent"
      },
      "DecisionRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Unique decision ID, e.g. DEC-20221020-001"
          },
          "type": {
            "type": "string",
            "enum": [
              "restock",
              "batch_release",
              "maintenance_pull_forward",
              "supplier_switch"
            ],
            "title": "Type",
            "description": "Decision action category"
          },
          "subject_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Subject Ids",
            "description": "Subject entities affected (SKU, batch, machine, supplier)"
          },
          "recommended_action": {
            "type": "string",
            "title": "Recommended Action",
            "description": "Specific recommended operational action"
          },
          "rule_tier": {
            "type": "string",
            "enum": [
              "BLOCK",
              "REVIEW",
              "AUTO-ELIGIBLE"
            ],
            "title": "Rule Tier",
            "description": "Deterministic rule tier (BLOCK, REVIEW, AUTO-ELIGIBLE)"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Computed confidence score in [0, 1]"
          },
          "rationale": {
            "type": "string",
            "title": "Rationale",
            "description": "Detailed rationale explaining trigger and tier logic"
          },
          "inputs_hash": {
            "type": "string",
            "title": "Inputs Hash",
            "description": "SHA-256 hash of canonical decision inputs"
          },
          "model_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Model Versions",
            "description": "Versions of models that contributed"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO UTC timestamp"
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "auto_executed",
              "pending_review",
              "approved",
              "rejected",
              "expired"
            ],
            "title": "Status",
            "description": "Lifecycle state",
            "default": "proposed"
          },
          "resolver": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolver",
            "description": "Username of resolver if acted upon"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At",
            "description": "ISO UTC timestamp of resolution"
          },
          "resolution_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolution Note",
            "description": "Note provided during resolution"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "type",
          "subject_ids",
          "recommended_action",
          "rule_tier",
          "confidence",
          "rationale",
          "inputs_hash"
        ],
        "title": "DecisionRecord"
      },
      "DemandShock": {
        "properties": {
          "type": {
            "type": "string",
            "const": "demand_shock",
            "title": "Type",
            "default": "demand_shock"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "pct_change": {
            "type": "number",
            "title": "Pct Change",
            "description": "Percentage change in demand (e.g. +0.25 for +25%, -0.30 for -30%)"
          },
          "start_day": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Day",
            "description": "Start day relative to simulation start"
          },
          "duration_days": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Duration Days",
            "description": "Duration of shock in days"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "pct_change",
          "start_day",
          "duration_days"
        ],
        "title": "DemandShock"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MachineOutage": {
        "properties": {
          "type": {
            "type": "string",
            "const": "machine_outage",
            "title": "Type",
            "default": "machine_outage"
          },
          "machine_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Machine Id"
          },
          "line_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line Id"
          },
          "start_day": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Start Day",
            "description": "Start day relative to simulation start"
          },
          "duration_h": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Duration H",
            "description": "Duration in hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start_day",
          "duration_h"
        ],
        "title": "MachineOutage"
      },
      "MitigationAction": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "expedite_raw_material",
              "inter_warehouse_transfer",
              "reprioritize_skus",
              "pull_forward_maintenance"
            ],
            "title": "Action Type"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "assumed_cost": {
            "type": "number",
            "title": "Assumed Cost"
          },
          "expected_profit_saved": {
            "type": "number",
            "title": "Expected Profit Saved"
          },
          "p_stockout_delta": {
            "type": "number",
            "title": "P Stockout Delta"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "action_type",
          "name",
          "description",
          "assumed_cost",
          "expected_profit_saved",
          "p_stockout_delta"
        ],
        "title": "MitigationAction"
      },
      "QualityShift": {
        "properties": {
          "type": {
            "type": "string",
            "const": "quality_shift",
            "title": "Type",
            "default": "quality_shift"
          },
          "product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "line_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Line Id"
          },
          "retest_rate_multiplier": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Retest Rate Multiplier",
            "description": "Multiplier on retest rate (e.g. 2.0 = double retests)"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "retest_rate_multiplier"
        ],
        "title": "QualityShift"
      },
      "ResolveDecisionRequest": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Action",
            "description": "Resolution action"
          },
          "resolution_note": {
            "type": "string",
            "title": "Resolution Note",
            "description": "Mandatory rationale or audit note"
          },
          "role": {
            "type": "string",
            "enum": [
              "planner",
              "qa_reviewer",
              "admin"
            ],
            "title": "Role",
            "description": "User role executing the resolution"
          },
          "username": {
            "type": "string",
            "title": "Username",
